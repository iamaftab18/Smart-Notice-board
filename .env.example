# Copy this file to .env and fill in real values before running the app.

# Random long string used to sign session cookies / CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Credentials for the one admin account, created by `flask seed-admin`.
ADMIN_NAME=College Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change-this-password

# Optional: how often (seconds) the public notice board polls for updates
# and, when more than one notice is published, how long each one is shown
# before rotating to the next.
BOARD_POLL_SECONDS=10
BOARD_ROTATE_SECONDS=12

# SMTP settings used to email students when a notice is published.
# Leave SMTP_HOST blank to disable email alerts entirely.
# Example for Gmail: host smtp.gmail.com, port 587, and an App Password
# (not your normal Gmail password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
